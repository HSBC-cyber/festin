  { id:18, title:"Aubergines Brûlées, Tahini & Grenade", category:"végétarien", emoji:"🍆", description:"Les aubergines sur la flamme vive jusqu'à carbonisation. La chair fumée avec le tahini crémeux.", ingredients:["2 aubergines","3 c. à s. tahini","1 citron","1 gousse d'ail","Graines de grenade","Persil plat","Cumin"], shopping:["2 aubergines","Tahini","1 citron","1 grenade","Persil plat","Cumin en poudre"], steps:["Brûler aubergines sur flamme gaz 15-20 min.","Laisser refroidir, récupérer la chair.","Égoutter 10 min.","Écraser avec tahini, citron, ail, cumin.","Garnir grenade, persil, huile d'olive."], time:"40 min", price:"€", rating:0, note:"", tag:"Végétarien" },
  { id:19, title:"Ravioles à la Poêle, Beurre Sauge Noisette", category:"végétarien", emoji:"🫙", description:"Des ravioles du commerce transformées par un beurre noisette et la sauge frite.", ingredients:["250g ravioles fraîches","50g beurre","8 feuilles de sauge","Parmesan","Poivre concassé"], shopping:["250g ravioles fraîches (frigo)","50g beurre","Sauge fraîche","Parmesan"], steps:["Cuire ravioles 2 min, égoutter.","Fondre beurre à feu moyen-vif.","Frire sauge 1 min, poursuivre jusqu'à noisette.","Sauter ravioles 2 min dans le beurre.","Servir avec copeaux de parmesan."], time:"15 min", price:"€", rating:0, note:"", tag:"Végétarien" },
  { id:20, title:"Gaspacho Noir à la Tomate Fumée & Paprika", category:"végétarien", emoji:"🍅", description:"Teinté par le paprika fumé jusqu'à une couleur bordeaux presque noire. Servi glacé, il entre comme une lame.", ingredients:["500g tomates mûres","1 concombre","1 poivron rouge","1 gousse d'ail","Vinaigre de xérès","Paprika fumé fort","Huile d'olive"], shopping:["500g tomates mûres","1 concombre","1 poivron rouge","1 gousse d'ail","Vinaigre de xérès","Paprika fumé fort","Basilic frais"], steps:["Couper grossièrement tous les légumes.","Mixer avec ail, vinaigre, paprika, huile, sel.","Passer au tamis fin.","Réfrigérer 1h minimum.","Servir dans verre sombre avec huile d'olive."], time:"20 min + 1h froid", price:"€", rating:0, note:"", tag:"Sans cuisson" },
  { id:21, title:"Côtes de Porc Laquées au Miso & Gingembre", category:"viande", emoji:"🐖", description:"Le miso caramélise en une croûte sombre, presque brûlée. Un laquage de précision sans four.", ingredients:["2 côtes de porc","2 c. à s. miso blanc","1 c. à s. sauce soja","1 c. à s. miel","1 c. à c. gingembre râpé","Huile de sésame"], shopping:["2 côtes de porc","Miso blanc","Sauce soja","Miel","Gingembre frais","Huile de sésame"], steps:["Mélanger miso, soja, miel, gingembre, ail.","Enduire les côtes, mariner 20 min.","Poêle huilée à feu moyen.","Cuire 5-6 min/face — laque doit noircir légèrement.","Reposer 3 min avant de servir."], time:"35 min", price:"€€", rating:0, note:"", tag:"Sans four" },
];

// ── STATE ─────────────────────────────────────────────────────────────────────
function loadRecipes() {
  try { const s = localStorage.getItem('festin'); return s ? JSON.parse(s) : INITIAL_RECIPES; } catch { return INITIAL_RECIPES; }
}
function saveRecipes(r) {
  try { localStorage.setItem('festin', JSON.stringify(r)); } catch {}
}

let state = {
  recipes: loadRecipes(),
  filter: 'tous',
  selected: null,
  showAdd: false,
  tab: 'recette',
  shopChecked: {},
  form: { title:'', category:'viande', emoji:'🍽️', description:'', ingredients:'', shopping:'', steps:'', time:'', price:'€', tag:'' },
  editNote: '',
  editRating: 0,
};

// ── RENDER ────────────────────────────────────────────────────────────────────
function render() {
  const app = document.getElementById('app');
  app.innerHTML = '';

  if (state.selected) { app.appendChild(renderDetail()); return; }
  if (state.showAdd)  { app.appendChild(renderAdd());    return; }
  app.appendChild(renderHome());
}

function renderHome() {
  const div = el('div', { id: 'home' });

  // Header
  const hdr = el('div', { className: 'header' });
  hdr.appendChild(el('div', { className: 'header-line' }));
  hdr.appendChild(el('p',   { className: 'header-sub',   textContent: 'Répertoire Culinaire Privé' }));
  hdr.appendChild(el('h1',  { className: 'header-title', textContent: 'Le Festin du Silence' }));
  hdr.appendChild(el('p',   { className: 'header-quote', textContent: '« Rude is what it is to eat the rude. »' }));
  div.appendChild(hdr);

  // Filters
  const filters = el('div', { className: 'filters' });
  Object.entries(CATEGORIES).forEach(([key, val]) => {
    const active = state.filter === key;
    const btn = el('button', {
      className: 'filter-btn',
      textContent: val.label,
      style: `background:${active ? val.color : 'transparent'};border:1px solid ${active ? val.color : '#1f1812'};color:${active ? '#0d0a07' : '#3a2e22'};`
    });
    btn.addEventListener('click', () => { state.filter = key; render(); });
    filters.appendChild(btn);
  });
  div.appendChild(filters);

  // Count
  const filtered = state.filter === 'tous' ? state.recipes : state.recipes.filter(r => r.category === state.filter);
  div.appendChild(el('p', { className: 'count', textContent: `${filtered.length} recette${filtered.length > 1 ? 's' : ''} au répertoire` }));

  // Grid
  const grid = el('div', { className: 'grid' });
  filtered.forEach(r => grid.appendChild(renderCard(r)));
  div.appendChild(grid);

  // FAB
  const fab = el('button', { className: 'fab', textContent: '+' });
  fab.addEventListener('click', () => { state.showAdd = true; state.form = { title:'', category:'viande', emoji:'🍽️', description:'', ingredients:'', shopping:'', steps:'', time:'', price:'€', tag:'' }; render(); });
  div.appendChild(fab);

  return div;
}

function renderCard(r) {
  const catColor = CATEGORIES[r.category]?.color || '#c9a96e';
  const card = el('div', { className: 'card' });
  card.appendChild(el('div', { className: 'card-bar', style: `background:${catColor}` }));

  const top = el('div', { className: 'card-top' });
  top.appendChild(el('span', { className: 'card-emoji', textContent: r.emoji }));
  const meta = el('div', { className: 'card-meta' });
  meta.appendChild(el('span', { className: 'card-tag', textContent: r.tag }));
  meta.appendChild(el('span', { className: 'card-price', textContent: r.price }));
  top.appendChild(meta);
  card.appendChild(top);

  card.appendChild(el('h3', { className: 'card-title', textContent: r.title }));
  card.appendChild(el('p', { className: 'card-desc', textContent: r.description.slice(0, 70) + '…' }));

  const footer = el('div', { className: 'card-footer' });
  footer.appendChild(el('span', { className: 'card-time', textContent: '⏱ ' + r.time }));
  if (r.rating > 0) footer.appendChild(el('span', { className: 'card-rating', textContent: '★'.repeat(r.rating) }));
  card.appendChild(footer);

  card.addEventListener('click', () => { state.selected = r; state.tab = 'recette'; state.shopChecked = {}; state.editNote = r.note || ''; state.editRating = r.rating || 0; render(); });
  return card;
}

function renderDetail() {
  const r = state.selected;
  const catColor = CATEGORIES[r.category]?.color || '#c9a96e';
  const screen = el('div', { className: 'screen' });

  // Header
  const hdr = el('div', { className: 'screen-header' });
  const back = el('button', { className: 'back-btn', textContent: '←' });
  back.addEventListener('click', () => { state.selected = null; render(); });
  hdr.appendChild(back);
  const info = el('div', { className: 'screen-header-info' });
  info.appendChild(el('p', { className: 'screen-tag', style: `color:${catColor}`, textContent: r.tag }));
  info.appendChild(el('h2', { className: 'screen-title', textContent: r.title }));
  hdr.appendChild(info);
  hdr.appendChild(el('span', { className: 'screen-emoji', textContent: r.emoji }));
  screen.appendChild(hdr);

  // Tabs
  const tabs = el('div', { className: 'tabs' });
  [['recette','Recette'],['courses','🛒 Courses'],['notes','Notes']].forEach(([t, label]) => {
    const btn = el('button', { className: 'tab-btn' + (state.tab === t ? ' active' : ''), textContent: label });
    if (state.tab === t) btn.style.borderBottomColor = catColor;
    btn.addEventListener('click', () => { state.tab = t; render(); });
    tabs.appendChild(btn);
  });
  screen.appendChild(tabs);

  // Content
  const content = el('div', { className: 'screen-content' });

  if (state.tab === 'recette') {
    const meta = el('div', { className: 'recipe-meta' });
    meta.appendChild(el('span', { textContent: '⏱ ' + r.time }));
    meta.appendChild(el('span', { textContent: r.price }));
    content.appendChild(meta);

    const desc = el('p', { className: 'recipe-desc', textContent: r.description });
    desc.style.borderLeft = `2px solid ${catColor}`;
    content.appendChild(desc);

    content.appendChild(el('p', { className: 'section-title', textContent: 'Ingrédients' }));
    const ul = el('ul', { className: 'ing-list' });
    r.ingredients.forEach(ing => {
      const li = el('li', { className: 'ing-item' });
      li.appendChild(el('span', { className: 'ing-dot', textContent: '◆' }));
      li.appendChild(el('span', { textContent: ing }));
      ul.appendChild(li);
    });
    content.appendChild(ul);

    content.appendChild(el('p', { className: 'section-title', textContent: 'Préparation' }));
    r.steps.forEach((step, i) => {
      const row = el('div', { className: 'step-row' });
      row.appendChild(el('span', { className: 'step-num', textContent: i + 1 }));
      row.appendChild(el('p', { className: 'step-text', textContent: step }));
      content.appendChild(row);
    });
  }

  if (state.tab === 'courses') {
    const items = r.shopping || r.ingredients;
    const done = Object.values(state.shopChecked).filter(Boolean).length;

    const sh = el('div', { className: 'shop-header' });
    sh.appendChild(el('span', { className: 'shop-label', textContent: '🛒 Courses — 2 personnes' }));
    sh.appendChild(el('span', { className: 'shop-count', id: 'shop-count', textContent: `${done}/${items.length}` }));
    content.appendChild(sh);

    items.forEach((item, i) => {
      const row = el('div', { className: 'shop-item' });
      const chk = el('div', { className: 'shop-check' + (state.shopChecked[i] ? ' done' : '') });
      if (state.shopChecked[i]) chk.appendChild(el('span', { textContent: '✓' }));
      const txt = el('span', { className: 'shop-text' + (state.shopChecked[i] ? ' done' : ''), textContent: item });
      row.appendChild(chk); row.appendChild(txt);
      row.addEventListener('click', () => { state.shopChecked[i] = !state.shopChecked[i]; render(); });
      content.appendChild(row);
    });

    if (done === items.length && items.length > 0) {
      content.appendChild(el('p', { className: 'shop-complete', textContent: 'Provisions complètes. Vous êtes prêt.' }));
    }
  }

  if (state.tab === 'notes') {
    const nh = el('div', { className: 'notes-header' });
    nh.appendChild(el('span', { className: 'notes-label', textContent: 'Appréciation' }));
    const stars = el('div', { className: 'stars' });
    [1,2,3,4,5].forEach(s => {
      const star = el('span', { className: 'star', textContent: '★', style: `color:${s <= state.editRating ? '#c9a96e' : '#2a2018'}` });
      star.addEventListener('click', () => { state.editRating = s === state.editRating ? 0 : s; render(); });
      stars.appendChild(star);
    });
    nh.appendChild(stars);
    content.appendChild(nh);

    const ta = el('textarea', { className: 'notes-textarea', placeholder: 'Vos observations, modifications, impressions…' });
    ta.value = state.editNote;
    ta.addEventListener('input', e => { state.editNote = e.target.value; });
    content.appendChild(ta);

    const saveBtn = el('button', { className: 'save-btn', textContent: 'Sauvegarder', style: `border:1px solid ${catColor};color:${catColor}` });
    saveBtn.addEventListener('click', () => {
      state.recipes = state.recipes.map(rec => rec.id === r.id ? { ...rec, note: state.editNote, rating: state.editRating } : rec);
      state.selected = { ...r, note: state.editNote, rating: state.editRating };
      saveRecipes(state.recipes);
      render();
    });
    content.appendChild(saveBtn);
  }

  screen.appendChild(content);
  return screen;
}

function renderAdd() {
  const screen = el('div', { className: 'screen' });

  const hdr = el('div', { className: 'screen-header' });
  const back = el('button', { className: 'back-btn', textContent: '←' });
  back.addEventListener('click', () => { state.showAdd = false; render(); });
  hdr.appendChild(back);
  hdr.appendChild(el('h2', { style: "font-family:'Playfair Display',serif;color:#e8dcc8;font-size:17px", textContent: 'Nouvelle Recette' }));
  screen.appendChild(hdr);

  const form = el('div', { style: 'padding:20px 20px 48px' });

  const addField = (label, key, type = 'input') => {
    const wrap = el('div', { className: 'form-field' });
    wrap.appendChild(el('label', { className: 'form-label', textContent: label }));
    let input;
    if (type === 'textarea') {
      input = el('textarea', { className: 'form-textarea', style: `min-height:${key==='steps'?'120px':key==='description'?'70px':'90px'}` });
      input.value = state.form[key];
    } else {
      input = el('input', { className: 'form-input' });
      input.value = state.form[key];
    }
    input.addEventListener('input', e => { state.form[key] = e.target.value; });
    wrap.appendChild(input);
    form.appendChild(wrap);
  };

  addField('Titre *', 'title');
  addField('Emoji', 'emoji');
  addField('Temps de préparation', 'time');
  addField('Tag (ex: Végétarien, Sans four…)', 'tag');

  // Row catégorie + prix
  const row = el('div', { className: 'form-row' });
  const catWrap = el('div');
  catWrap.appendChild(el('label', { className: 'form-label', textContent: 'Catégorie' }));
  const catSel = el('select', { className: 'form-input', style: 'cursor:pointer' });
  Object.entries(CATEGORIES).filter(([k]) => k !== 'tous').forEach(([k, v]) => {
    const opt = el('option', { value: k, textContent: v.label });
    if (state.form.category === k) opt.selected = true;
    catSel.appendChild(opt);
  });
  catSel.addEventListener('change', e => { state.form.category = e.target.value; });
  catWrap.appendChild(catSel);
  row.appendChild(catWrap);

  const prixWrap = el('div');
  prixWrap.appendChild(el('label', { className: 'form-label', textContent: 'Prix' }));
  const prixSel = el('select', { className: 'form-input', style: 'cursor:pointer' });
  [['€','€ Modeste'],['€€','€€ Raisonnable'],['€€€','€€€ Raffiné']].forEach(([v, t]) => {
    const opt = el('option', { value: v, textContent: t });
    if (state.form.price === v) opt.selected = true;
    prixSel.appendChild(opt);
  });
  prixSel.addEventListener('change', e => { state.form.price = e.target.value; });
  prixWrap.appendChild(prixSel);
  row.appendChild(prixWrap);
  form.appendChild(row);

  addField('Description', 'description', 'textarea');
  addField('Ingrédients — un par ligne', 'ingredients', 'textarea');
  addField('Liste de courses (2 pers.) — un par ligne', 'shopping', 'textarea');
  addField('Étapes — une par ligne', 'steps', 'textarea');

  const addBtn = el('button', { className: 'add-btn', textContent: 'Inscrire au Répertoire' });
  addBtn.addEventListener('click', () => {
    if (!state.form.title.trim()) return;
    const newR = {
      id: Date.now(),
      ...state.form,
      ingredients: state.form.ingredients.split('\n').filter(Boolean),
      shopping: state.form.shopping.split('\n').filter(Boolean),
      steps: state.form.steps.split('\n').filter(Boolean),
      rating: 0, note: ''
    };
    state.recipes = [...state.recipes, newR];
    saveRecipes(state.recipes);
    state.showAdd = false;
    render();
  });
  form.appendChild(addBtn);
  screen.appendChild(form);
  return screen;
}

// ── UTILS ─────────────────────────────────────────────────────────────────────
function el(tag, props = {}) {
  const e = document.createElement(tag);
  Object.entries(props).forEach(([k, v]) => {
    if (k === 'style' && typeof v === 'string') e.style.cssText += v;
    else if (k in e) e[k] = v;
    else e.setAttribute(k, v);
  });
  return e;
}

// ── BOOT ──────────────────────────────────────────────────────────────────────
render();
</script>

