#app { min-height: 100vh; background: #0d0a07; }

/* HEADER */
.header { border-bottom: 1px solid #141008; padding: 28px 20px 18px; text-align: center; position: relative; }
.header-line { position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, transparent, #c9a96e 30%, #8b2020 50%, #c9a96e 70%, transparent); }
.header-sub { color: #1f1812; font-size: 9px; letter-spacing: 6px; text-transform: uppercase; margin-bottom: 8px; }
.header-title { font-family: 'Playfair Display', serif; font-size: clamp(22px, 7vw, 40px); font-weight: 700; color: #e8dcc8; margin-bottom: 5px; }
.header-quote { color: #1f1812; font-size: 11px; font-style: italic; }

/* FILTERS */
.filters { padding: 14px 16px 0; display: flex; gap: 6px; flex-wrap: wrap; }
.filter-btn { border: none; padding: 5px 12px; cursor: pointer; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; transition: all .2s; }
.count { padding: 10px 16px 0; color: #1f1812; font-size: 10px; letter-spacing: 2px; }

/* GRID */
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; padding: 12px 16px 100px; }

/* CARD */
.card { background: linear-gradient(150deg, #181310 0%, #1e1812 100%); border: 1px solid #1f1812; padding: 18px 16px; cursor: pointer; position: relative; overflow: hidden; transition: border-color .2s; }
.card:active { border-color: #c9a96e; }
.card-bar { position: absolute; top: 0; left: 0; right: 0; height: 2px; }
.card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
.card-emoji { font-size: 22px; }
.card-meta { text-align: right; }
.card-tag { display: block; font-size: 9px; letter-spacing: 2px; color: #2a2018; text-transform: uppercase; }
.card-price { font-size: 11px; color: #c9a96e; }
.card-title { font-family: 'Playfair Display', serif; color: #ddd0b8; font-size: 13px; font-weight: 600; margin-bottom: 6px; line-height: 1.4; }
.card-desc { color: #3a2e22; font-size: 11px; line-height: 1.6; margin-bottom: 10px; font-style: italic; }
.card-footer { display: flex; justify-content: space-between; align-items: center; }
.card-time { color: #2a2018; font-size: 10px; }
.card-rating { color: #c9a96e; font-size: 11px; }

/* FAB */
.fab { position: fixed; bottom: 24px; right: 20px; z-index: 100; background: linear-gradient(135deg, #2a1a08, #1a1008); border: 1px solid #c9a96e; color: #c9a96e; width: 52px; height: 52px; border-radius: 50%; cursor: pointer; font-size: 24px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 20px rgba(0,0,0,0.6); }

/* SCREEN (detail + add) */
.screen { position: fixed; inset: 0; z-index: 200; background: #0d0a07; display: flex; flex-direction: column; overflow-y: auto; }
.screen-header { position: sticky; top: 0; z-index: 10; background: #0d0a07; border-bottom: 1px solid #1a1410; padding: 14px 20px; display: flex; align-items: center; gap: 14px; }
.back-btn { background: none; border: none; color: #c9a96e; font-size: 22px; cursor: pointer; padding: 2px 8px 2px 0; }
.screen-header-info { flex: 1; min-width: 0; }
.screen-tag { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 2px; }
.screen-title { font-family: 'Playfair Display', serif; color: #e8dcc8; font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.screen-emoji { font-size: 28px; }

/* TABS */
.tabs { display: flex; border-bottom: 1px solid #1a1410; background: #0d0a07; flex-shrink: 0; }
.tab-btn { flex: 1; background: none; border: none; border-bottom: 2px solid transparent; color: #3a2e22; padding: 12px 4px; cursor: pointer; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; transition: color .2s; }
.tab-btn.active { color: #c9a96e; }

/* CONTENT */
.screen-content { padding: 20px 20px 40px; flex: 1; }
.recipe-meta { display: flex; gap: 12px; margin-bottom: 16px; }
.recipe-meta span { color: #c9a96e; font-size: 12px; }
.recipe-desc { color: #6a5a4a; font-style: italic; font-size: 14px; line-height: 1.7; margin-bottom: 22px; padding-left: 14px; }
.section-title { color: #c9a96e; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 10px; }
.ing-list { list-style: none; margin-bottom: 22px; }
.ing-item { color: #7a6a5a; font-size: 14px; padding: 7px 0; border-bottom: 1px solid #161210; display: flex; gap: 10px; align-items: flex-start; }
.ing-dot { color: #2a2018; font-size: 7px; margin-top: 6px; flex-shrink: 0; }
.step-row { display: flex; gap: 14px; margin-bottom: 14px; }
.step-num { font-family: 'Playfair Display', serif; color: #2a2018; font-size: 22px; min-width: 24px; line-height: 1.3; flex-shrink: 0; }
.step-text { color: #7a6a5a; font-size: 14px; line-height: 1.75; }

/* SHOPPING */
.shop-header { display: flex; justify-content: space-between; margin-bottom: 16px; align-items: center; }
.shop-label { color: #c9a96e; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; }
.shop-count { color: #2a2018; font-size: 11px; }
.shop-item { display: flex; align-items: center; gap: 14px; padding: 11px 0; border-bottom: 1px solid #161210; cursor: pointer; }
.shop-check { width: 18px; height: 18px; border: 1px solid #2a2018; background: transparent; flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all .2s; }
.shop-check.done { border-color: #c9a96e; background: #c9a96e; }
.shop-check.done span { color: #0d0a07; font-size: 11px; font-weight: bold; }
.shop-text { font-size: 14px; color: #8a7a6a; transition: all .2s; }
.shop-text.done { color: #2a2018; text-decoration: line-through; }
.shop-complete { color: #2a5c1a; font-size: 11px; letter-spacing: 2px; text-align: center; margin-top: 16px; font-style: italic; }

/* NOTES */
.notes-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
.notes-label { color: #c9a96e; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; }
.stars { display: flex; gap: 6px; }
.star { font-size: 26px; cursor: pointer; transition: color .2s; user-select: none; }
.notes-textarea { width: 100%; background: #0c0906; border: 1px solid #1f1812; color: #8a7a6a; font-size: 14px; padding: 14px; resize: vertical; min-height: 140px; font-family: Georgia, serif; font-style: italic; outline: none; line-height: 1.7; }
.save-btn { margin-top: 14px; width: 100%; background: transparent; padding: 14px; cursor: pointer; font-family: 'Playfair Display', serif; font-size: 13px; letter-spacing: 3px; text-transform: uppercase; }

/* ADD FORM */
.form-field { margin-bottom: 14px; }
.form-label { color: #c9a96e; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; display: block; margin-bottom: 5px; }
.form-input { width: 100%; background: #0c0906; border: 1px solid #1f1812; color: #a09080; font-size: 15px; padding: 11px 12px; outline: none; }
.form-row { display: flex; gap: 10px; margin-bottom: 14px; }
.form-row > div { flex: 1; }
.form-textarea { width: 100%; background: #0c0906; border: 1px solid #1f1812; color: #a09080; font-size: 14px; padding: 11px 12px; outline: none; resize: vertical; font-family: Georgia, serif; }
.add-btn { width: 100%; background: transparent; border: 1px solid #c9a96e; color: #c9a96e; padding: 16px; cursor: pointer; font-family: 'Playfair Display', serif; font-size: 13px; letter-spacing: 3px; text-transform: uppercase; margin-top: 8px; }
